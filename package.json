{
  "name": "dsh-limit-timeout",
  "version": "0.1.0",
  "description": "Cap how long one DSH tool call may wait: a global default wait limit in Settings, plus a per-session raise the model can request from the user.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh-plugin.naming.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:host": "tsdown --config tsdown.host.config.ts",
    "build:client": "tsdown --config tsdown.client.config.ts",
    "build": "pnpm run build:host && pnpm run build:client",
    "test": "vitest run",
    "check:client": "node scripts/check-client.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:client"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "packageManager": "pnpm@12.3.4",
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-user-approval": ">=0.1.7-rc.2 <0.2.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-store": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-invariants": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-sandbox": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-scope": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-user-approval": ">=0.1.7-rc.2 <0.2.0",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.1",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "timeout",
    "wait",
    "budget",
    "approval"
  ]
}
